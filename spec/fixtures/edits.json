          "status": "updated",
          "value": {
            "new": false
          }
        },
        {
          "action": "retire",
          "selector": [
            "mcp",
            "x"
          ],
          "expected": "{\"mcp\":{\"x\": /* key */ {\"old\":true /* owned */}}}",
          "status": "removed"
        }
      ]
    },
