    {
      "name": "toml-nested-mcp-published-snapshot-and-live-trivia",
      "format": "toml",
      "before": "[mcp.test] # header\ncommand=\"old\"\n[mcp . test . env] # nested\nX=\"before\"\n# gap\n",
      "steps": [
        {
          "action": "set",
          "selector": [
            "mcp",
            "test"
          ],
          "value": {
            "command": "cmd",
            "env": {
              "X": "y"
            }
          },
          "acquisition": "takeover",
          "expected": "[mcp.test] # header\ncommand = \"cmd\"\n\n[mcp.test.env]\nX = \"y\"\n# gap\n",
          "status": "taken-over"
        },
        {
          "action": "set",
          "selector": [
            "mcp",
            "test"
          ],
          "value": {
            "command": "new",
            "env": {
              "X": "z"
            }
          },
          "expected": "[mcp.test] # header\ncommand = \"new\"\n\n[mcp.test.env]\nX = \"z\"\n# gap\n",
          "status": "updated"
        },
        {
          "action": "retire",
          "selector": [
            "mcp",
            "test"
          ],
          "observed": "[mcp.test] # live\ncommand = \"new\"\n\n[mcp.test.env]\nX = \"z\"\n# live gap\n",
          "expected": "[mcp.test] # live\ncommand=\"old\"\n[mcp . test . env] # nested\nX=\"before\"\n# live gap\n",
          "status": "removed"
        }
      ]
    },
