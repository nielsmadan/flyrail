{
  "schema_version": 1,
  "cases": [
    {
      "name": "custom-section-first-baseline",
      "format": "text",
      "before": "﻿User\r\n<!-- splashdown:start -->\r\n old \r\n<!-- splashdown:end -->\r\nTail",
      "steps": [
        {
          "action": "set",
          "selector": {
            "start": "<!-- splashdown:start -->",
            "end": "<!-- splashdown:end -->"
          },
          "expected": "﻿User\r\n<!-- splashdown:start -->\r\n old \r\n<!-- splashdown:end -->\r\nTail",
          "status": "conflict",
          "text": "new\n"
        },
        {
          "action": "set",
          "selector": {
            "start": "<!-- splashdown:start -->",
            "end": "<!-- splashdown:end -->"
          },
          "expected": "﻿User\r\n<!-- splashdown:start -->\r\nnew\r\n<!-- splashdown:end -->\r\nTail",
          "status": "taken-over",
          "text": "new\n",
          "acquisition": "takeover"
        },
        {
          "action": "set",
          "selector": {
            "start": "<!-- splashdown:start -->",
            "end": "<!-- splashdown:end -->"
          },
          "expected": "﻿User\r\n<!-- splashdown:start -->\r\nnewer\r\n<!-- splashdown:end -->\r\nTail",
          "status": "updated",
          "text": "newer\n",
          "marker": "renamed"
        },
        {
          "action": "retire",
          "selector": {
            "start": "<!-- splashdown:start -->",
            "end": "<!-- splashdown:end -->"
          },
          "expected": "﻿User\r\n<!-- splashdown:start -->\r\n old \r\n<!-- splashdown:end -->\r\nTail",
          "status": "removed"
        }
      ]
    },
    {
      "name": "exact-section-adoption",
      "format": "text",
      "before": "Before\nSTART\ngenerated\nEND\nAfter\n",
      "steps": [
        {
          "action": "set",
          "selector": {
            "start": "START",
            "end": "END"
          },
          "expected": "Before\nSTART\ngenerated\nEND\nAfter\n",
          "status": "adopted",
          "text": "generated\n",
          "acquisition": "adopt"
        },
        {
          "action": "retire",
          "selector": {
            "start": "START",
            "end": "END"
          },
          "expected": "Before\nAfter\n",
          "status": "removed"
        }
      ]
    },
    {
      "name": "mixed-newline-section-adoption",
