    {
      "name": "array-stable-identity-baseline",
      "format": "json",
      "before": "{\"hooks\":[{\"name\":\"a\"},{\"name\":\"x\",\"v\":1},{\"name\":\"b\"}]}",
      "steps": [
        {
          "action": "set",
          "selector": [
            "hooks",
            {
              "key": [
                "name"
              ],
              "identity": "x"
            }
          ],
          "expected": "{\"hooks\":[{\"name\":\"a\"},{\"name\":\"b\"},{\"name\":\"x\",\"v\":2}]}",
          "status": "taken-over",
          "value": {
            "name": "x",
            "v": 2
          },
          "acquisition": "takeover",
          "placement": {
            "position": "last"
          }
        },
        {
          "action": "set",
          "selector": [
            "hooks",
            {
              "key": [
                "name"
              ],
              "identity": "x"
            }
          ],
          "expected": "{\"hooks\":[{\"name\":\"a\"},{\"name\":\"b\"},{\"name\":\"x\",\"v\":3}]}",
          "status": "updated",
          "value": {
            "name": "x",
            "v": 3
          }
        },
        {
          "action": "retire",
          "selector": [
            "hooks",
            {
              "key": [
                "name"
              ],
              "identity": "x"
            }
          ],
          "expected": "{\"hooks\":[{\"name\":\"a\"},{\"name\":\"x\",\"v\":1},{\"name\":\"b\"}]}",
          "status": "removed"
        }
      ]
    },
